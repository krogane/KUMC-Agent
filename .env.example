KUMC_VC_FEATURE_ENABLED=0
KUMC_VC_AUTO_JOIN_ENABLED=0
KUMC_VC_AUTO_JOIN_WEEKDAYS=sat
KUMC_VC_AUTO_JOIN_TIME=19:50
KUMC_VC_AUTO_JOIN_DURATION_MINUTES=30
KUMC_VC_TARGET_VOICE_CHANNEL_NAME=例会
KUMC_VC_AUTO_JOIN_MIN_PARTICIPANTS=3
KUMC_VC_PARTICIPANT_CHECK_INTERVAL_SECONDS=10
KUMC_VC_SUMMARY_TRANSCRIBE_INTERVAL_SECONDS=300
KUMC_VC_TRANSCRIBE_MODEL=model/whisper/openai/whisper-large-v3-turbo
