# KUMC-Agent v2 environment variables
KUMC_EXPERIMENT_PROFILE=rag/baseline
KUMC_LOG_LEVEL=INFO

KUMC_DISCORD_BOT_TOKEN=
KUMC_GEMINI_API_KEY=
KUMC_GOOGLE_APPLICATION_CREDENTIALS=.secrets/google-sa.json
KUMC_DRIVE_FOLDER_ID=

KUMC_COMMAND_PREFIX=/ai
KUMC_INDEX_COMMAND_PREFIX=/ai build-index
KUMC_MAX_INPUT_CHARACTERS=1024

KUMC_LLM_PROVIDER=gemini
KUMC_LLM_GEMINI_MODEL=gemini-3.1-flash-lite-preview
KUMC_LLM_LLAMA_MODEL_PATH=model/llm/gemma-3n-E2B-it-IQ4_XS.gguf
KUMC_LLM_TEMPERATURE=0.0
KUMC_LLM_MAX_OUTPUT_TOKENS=1024
KUMC_LLM_THINKING_LEVEL=minimal
KUMC_LLM_THREADS=4
KUMC_LLM_GPU_LAYERS=0

KUMC_EMBEDDING_PROVIDER=local
KUMC_EMBEDDING_MODEL=intfloat/multilingual-e5-small
KUMC_EMBEDDING_DIMENSIONS=256

KUMC_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
KUMC_RERANKER_ENABLED=1

KUMC_FUNCTION_CALL_ENABLED=1
KUMC_FUNCTION_CALL_PROVIDER=gemini
KUMC_FUNCTION_CALL_GEMINI_MODEL=gemini-2.5-flash-lite
KUMC_FUNCTION_CALL_LLAMA_MODEL_PATH=model/llm/Qwen3-0.6B-IQ4_XS.gguf

KUMC_MODEL_ROOT_DIR=model
KUMC_MODEL_LLM_DIR=model/llm
KUMC_MODEL_EMBEDDING_DIR=model/embedding
KUMC_MODEL_CROSS_ENCODER_DIR=model/cross-encoder
KUMC_MODEL_WHISPER_DIR=model/whisper
KUMC_MODEL_OCR_DIR=model/ocr

KUMC_DRIVE_MAX_FILES=0
KUMC_CRAFTERS_COLONY_AUTHOR_URL=
KUMC_CRAFTERS_COLONY_MAX_PAGES=100
KUMC_CRAFTERS_COLONY_MAX_ARTICLES=0

KUMC_AUTO_INDEX_ENABLED=0
KUMC_AUTO_INDEX_TIME=03:00
KUMC_AUTO_INDEX_WEEKDAYS=mon,tue,wed,thu,fri

KUMC_FEATURE_RAG=1
KUMC_FEATURE_INDEXING=1
KUMC_FEATURE_EVAL=1
KUMC_FEATURE_SUMMARIZATION=1
KUMC_FEATURE_VC=0
KUMC_FEATURE_DOCGEN=0
KUMC_FEATURE_HTTP=0

KUMC_RETRIEVAL_TOP_K=8
